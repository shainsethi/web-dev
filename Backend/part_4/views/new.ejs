<%- include("includes/head", { title: "New Post" }) %>
<main class="page">
  <h1>New Post</h1>
  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>
  <form class="card" action="/posts" method="post">
    <label for="username">Username</label>
    <input id="username" name="username" maxlength="30" value="<%= username %>" required>
    <label for="content">Post</label>
    <textarea id="content" name="content" maxlength="500" rows="5" required><%= content %></textarea>
    <button class="button">Add post</button>
  </form>
  <a href="/posts">Back to all posts</a>
</main>
<%- include("includes/footer") %>
